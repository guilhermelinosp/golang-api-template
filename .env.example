# ─────────────────────────────────────────────────────────────────────────────
# Application-owned configuration (this template)
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=golang-api-template
APP_ENV=Development            # production enables Gin release mode
APP_PORT=8080
APP_SHUTDOWN_TIMEOUT=10s       # must stay < terminationGracePeriodSeconds (k8s)
# APP_READ_TIMEOUT=15s
# APP_WRITE_TIMEOUT=30s
# APP_IDLE_TIMEOUT=120s
# APP_READ_HEADER_TIMEOUT=10s
# APP_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# ─────────────────────────────────────────────────────────────────────────────
# Telemetry — owned EXCLUSIVELY by hellnet-lib-telemetry (do NOT mirror these
# into APP_* names). Docs: https://github.com/guilhermelinosp/hellnet-lib-telemetry
# ─────────────────────────────────────────────────────────────────────────────
HELLNET_TELEMETRY_SERVICE=golang-api-template
# Without ENDPOINT the SDK starts disabled and the API still serves
# /live /ready /health /metrics locally. Set it to enable OTLP export.
HELLNET_TELEMETRY_ENDPOINT=http://alloy.monitoring:4318
HELLNET_TELEMETRY_ENVIRONMENT=Development
# Optional explicit override of signal enablement (true|false):
# HELLNET_TELEMETRY_ENABLED=false
# Optional explicit .env location for the library loader:
# HELLNET_TELEMETRY_ENV_FILE=./.env
